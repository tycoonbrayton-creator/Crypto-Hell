  <script>
    (function() {
      // ----- RENDER SIMPLE LINE CHART (canvas) -----
      const canvas = document.getElementById('priceChart');
      const ctx = canvas.getContext('2d');

      // generate realistic price data around 63k
      const basePrice = 63800;
      const points = 50;
      const data = [];
      let price = basePrice;
      for (let i = 0; i < points; i++) {
        const change = (Math.random() - 0.48) * 220; // slight upward bias
        price = Math.max(62800, Math.min(64700, price + change));
        data.push(price);
      }

      function drawChart() {
        const width = canvas.width;
        const height = canvas.height;
        const padding = { top: 20, bottom: 20, left: 10, right: 10 };
        const chartWidth = width - padding.left - padding.right;
        const chartHeight = height - padding.top - padding.bottom;

        const minVal = Math.min(...data) - 100;
        const maxVal = Math.max(...data) + 100;
        const range = maxVal - minVal;

        // clear with dark background
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = '#0f1318';
        ctx.fillRect(0, 0, width, height);

        // draw grid lines
        ctx.strokeStyle = '#1e262e';
        ctx.lineWidth = 0.8;
        for (let i = 0; i <= 4; i++) {
          const y = padding.top + (i / 4) * chartHeight;
          ctx.beginPath();
          ctx.moveTo(padding.left, y);
          ctx.lineTo(width - padding.right, y);
          ctx.stroke();
        }

        // draw the price line
        ctx.beginPath();
        ctx.strokeStyle = '#14b87a';
        ctx.lineWidth = 2.5;
        ctx.shadowColor = '#14b87a';
        ctx.shadowBlur = 12;

        for (let i = 0; i < data.length; i++) {
          const x = padding.left + (i / (data.length - 1)) * chartWidth;
          const y = padding.top + chartHeight - ((data[i] - minVal) / range) * chartHeight;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // draw area under line (gradient)
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.moveTo(padding.left, padding.top + chartHeight);
        for (let i = 0; i < data.length; i++) {
          const x = padding.left + (i / (data.length - 1)) * chartWidth;
          const y = padding.top + chartHeight - ((data[i] - minVal) / range) * chartHeight;
          ctx.lineTo(x, y);
        }
        ctx.lineTo(padding.left + chartWidth, padding.top + chartHeight);
        ctx.closePath();
        const gradient = ctx.createLinearGradient(0, padding.top, 0, padding.top + chartHeight);
        gradient.addColorStop(0, 'rgba(20, 184, 122, 0.25)');
        gradient.addColorStop(1, 'rgba(20, 184, 122, 0.0)');
        ctx.fillStyle = gradient;
        ctx.fill();
      }

      drawChart();

      // ----- ORDERBOOK dynamic population -----
      const asksContainer = document.getElementById('asksContainer');
      const bidsContainer = document.getElementById('bidsContainer');
      const midPriceSpan = document.getElementById('midPrice');

      function generateOrderbook() {
        // Asks (sells) – 6 levels above mid
        const asks = [];
        const bids = [];
        const mid = 63824.5;

        for (let i = 1; i <= 6; i++) {
          const askPrice = mid + i * 12.5 + Math.random() * 5;
          const askAmount = (Math.random() * 1.5 + 0.1).toFixed(3);
          const depth = Math.floor(Math.random() * 40 + 20); // percentage for bar width
          asks.push({ price: askPrice.toFixed(2), amount: askAmount, depth: depth + '%' });
        }

        for (let i = 1; i <= 6; i++) {
          const bidPrice = mid - i * 12.5 - Math.random() * 5;
          const bidAmount = (Math.random() * 1.8 + 0.1).toFixed(3);
          const depth = Math.floor(Math.random() * 40 + 20);
          bids.push({ price: bidPrice.toFixed(2), amount: bidAmount, depth: depth + '%' });
        }

        // render asks (reverse order so highest ask at top? Actually trading view shows lowest ask at top near mid)
        // we want lowest ask just above mid. So sort ascending: lowest first
        asks.sort((a, b) => parseFloat(a.price) - parseFloat(b.price));
        bids.sort((a, b) => parseFloat(b.price) - parseFloat(a.price)); // highest bid first

        asksContainer.innerHTML = asks.map(a => `
          <div class="order-row" style="--depth:${a.depth}">
            <span class="price" style="color:#f6465d;">${parseFloat(a.price).toLocaleString()}</span>
            <span class="amount">${a.amount}</span>
          </div>
        `).join('');

        bidsContainer.innerHTML = bids.map(b => `
          <div class="order-row" style="--depth:${b.depth}">
            <span class="price" style="color:#14b87a;">${parseFloat(b.price).toLocaleString()}</span>
            <span class="amount">${b.amount}</span>
          </div>
        `).join('');

        // update mid price with small variation
        const newMid = (mid + (Math.random() - 0.5) * 15).toFixed(2);
        midPriceSpan.innerHTML = `${parseFloat(newMid).toLocaleString()} <span>+1.2%</span>`;
      }

      generateOrderbook();

      // refresh orderbook every 8 seconds (realistic liveliness)
      setInterval(() => {
        generateOrderbook();
        // also update recent trades occasionally
        addRecentTrade();
      }, 8000);

      // ----- RECENT TRADES list -----
      const recentTrades = document.getElementById('recentTrades');

      function addRecentTrade() {
        const price = (63800 + (Math.random() - 0.5) * 200).toFixed(2);
        const amount = (Math.random() * 0.9 + 0.01).toFixed(4);
        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const isBuy = Math.random() > 0.5;

        const tradeEl = document.createElement('div');
        tradeEl.className = 'trade-item';
        tradeEl.innerHTML = `
          <span class="price ${isBuy ? '' : 'sell'}">${parseFloat(price).toLocaleString()}</span>
          <span>${amount} BTC</span>
          <span class="time">${time}</span>
        `;
        recentTrades.prepend(tradeEl);

        // keep only 6 items
        while (recentTrades.children.length > 6) {
          recentTrades.removeChild(recentTrades.lastChild);
        }
      }

      // seed initial recent trades
      for (let i = 0; i < 5; i++) {
        setTimeout(() => addRecentTrade(), i * 300);
      }

      // ----- BUY / SELL TAB and action button -----
      const buyTab = document.getElementById('buyTab');
      const sellTab = document.getElementById('sellTab');
      const actionBtn = document.getElementById('actionBtn');
      const priceInput = document.getElementById('priceInput');
      const amountInput = document.getElementById('amountInput');
      const totalInput = document.getElementById('totalInput');

      let isBuy = true;

      buyTab.addEventListener('click', () => {
        isBuy = true;
        buyTab.classList.add('active-buy');
        sellTab.classList.remove('active-sell');
        actionBtn.textContent = 'Buy BTC';
        actionBtn.classList.remove('sell');
        updateTotal();
      });

      sellTab.addEventListener('click', () => {
        isBuy = false;
        sellTab.classList.add('active-sell');
        buyTab.classList.remove('active-buy');
        actionBtn.textContent = 'Sell BTC';
        actionBtn.classList.add('sell');
        updateTotal();
      });

      function updateTotal() {
        const price = parseFloat(priceInput.value.replace(/,/g, '')) || 0;
        const amount = parseFloat(amountInput.value) || 0;
        const total = price * amount;
        totalInput.value = total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      // quick percent buttons (only affect amount based on a pretend balance)
      document.querySelectorAll('.quick-percent button').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const percent = parseInt(e.target.textContent);
          // simulate balance 1 BTC for demo
          const fakeBalance = 1.0;
          const newAmount = (fakeBalance * percent / 100).toFixed(4);
          amountInput.value = newAmount;
          updateTotal();
        });
      });

      // event listeners for inputs
      priceInput.addEventListener('input', updateTotal);
      amountInput.addEventListener('input', updateTotal);

      // initialize total
      updateTotal();

      // action button feedback
      actionBtn.addEventListener('click', () => {
        const action = isBuy ? 'Buy' : 'Sell';
        const amount = amountInput.value;
        alert(`${action} order placed for ${amount} BTC at ${priceInput.value} USDT (demo)`);
      });

      // minor price update simulation: change main price slightly every 5 sec
      setInterval(() => {
        const currentPriceEl = document.getElementById('currentPrice');
        let currentVal = parseFloat(currentPriceEl.textContent.replace(/,/g, ''));
        const change = (Math.random() - 0.5) * 30;
        let newVal = currentVal + change;
        newVal = Math.max(62500, Math.min(65200, newVal));
        currentPriceEl.textContent = newVal.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        // also update price input if not focused
        if (document.activeElement !== priceInput) {
          priceInput.value = newVal.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          updateTotal();
        }
        // change percentage indicator
        const changePercent = ((newVal - 63800) / 63800 * 100).toFixed(2);
        const changeEl = document.getElementById('priceChange');
        if (changePercent >= 0) {
          changeEl.className = 'change';
          changeEl.innerHTML = `<i class="fas fa-arrow-up"></i> +${changePercent}%`;
        } else {
          changeEl.className = 'change negative';
          changeEl.innerHTML = `<i class="fas fa-arrow-down"></i> ${changePercent}%`;
        }
      }, 6000);
    })();
  </script>
</body>
</html>